{
  "name": "@8yy6xg/pi-ssh-remote",
  "version": "0.7.0",
  "private": true,
  "description": "Route Pi's file and shell tools to remote Unix or Windows workspaces through reusable OpenSSH or ssh2 transports, with automatic reconnect after unexpected connection loss",
  "type": "module",
  "scripts": {
    "build": "bun run scripts/build-package.ts",
    "test": "node --import tsx --test --test-isolation=process tests/reconnect.test.ts tests/ssh-remote.test.ts tests/ssh-remote-windows-integration.test.ts",
    "test:unit": "node --import tsx --test --test-isolation=process tests/reconnect.test.ts tests/ssh-remote.test.ts",
    "lint": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "piBuild": {
    "bundlePackages": [
      "@99percentpeople/pi-shared-settings",
      "@99percentpeople/pi-workspace-files"
    ]
  },
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "ssh",
    "remote-development",
    "openssh",
    "ssh2",
    "background-tasks",
    "pty",
    "tui",
    "reconnect"
  ],
  "author": "8yy6xg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/8yy6xg/pi-ssh-remote.git"
  },
  "bugs": {
    "url": "https://github.com/8yy6xg/pi-ssh-remote/issues"
  },
  "homepage": "https://github.com/8yy6xg/pi-ssh-remote#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "@99percentpeople/pi-shared-settings": "0.1.4",
    "@99percentpeople/pi-workspace-files": "0.1.1",
    "ssh2": "1.17.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "26.1.2",
    "@types/ssh2": "1.15.5",
    "tsx": "latest",
    "typebox": "1.3.7",
    "typescript": "^5.0.0"
  }
}
